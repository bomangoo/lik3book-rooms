{
  "name": "lik3book-rooms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "겨울 밤, 함께 책을 읽고 사색하는 2D 온라인 서재",
  "scripts": {
    "dev": "concurrently -k -n web,server -c magenta,cyan \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.7"
  }
}
